PROBE_ID=nss-001
INTERFACE=enp5s0              # 抓包网卡（必须按服务器实际网卡填写）

# 凭据
ELASTIC_PASSWORD=nss-ndr@2026
FB_PASSWORD=CHANGE_ME_filebeat
XDR_PASSWORD=CHANGE_ME_xdr

# 服务
MANAGER_PORT=30603            # 管理后台端口
ES_HOST=http://elasticsearch:9200
