# NSS-NDR docker-compose 部署环境变量（复制为 .env 后填写；deploy.sh install 可自动生成）

# 探针基础
PROBE_ID=nss-001
INTERFACE=enp5s0              # 抓包网卡（必须按服务器实际网卡填写）

# 凭据
ELASTIC_PASSWORD=nss-ndr@2026
FB_PASSWORD=CHANGE_ME_filebeat
XDR_PASSWORD=CHANGE_ME_xdr

# 服务
MANAGER_PORT=30603            # 管理后台端口
ES_HOST=http://elasticsearch:9200
ES_USERNAME=xdr-push
ES_HEAP_GB=2

# 本地分析 Agent（默认指向本探针内置 ollama 服务，CPU 优化版 Qwen3-0.6B）
# 留空则用默认值：LLM_URL=http://ollama:11434/v1/chat/completions，LLM_MODEL=qwen3-ndr
LLM_URL=
LLM_MODEL=
LLM_API_KEY=
# Agent /analyze 端点鉴权（建议设置；与 xdr.agent_task_token 保持一致）
AGENT_TOKEN=
# Ollama 优化参数（留空则自动用 nproc）
OLLAMA_NUM_THREADS=
OLLAMA_KEEP_ALIVE=24h
# Ollama 模型挂载（外挂 GGUF；deploy.sh install 时若检测到项目根的 GGUF 会自动拷贝到这里）
OLLAMA_MODELS_DIR=/opt/ndr/ollama-models
# 期望的 GGUF 文件名（与 Modelfile 中的 FROM 路径一致）
OLLAMA_GGUF_NAME=Qwen3-0.6B-Q5_K_M.gguf

# XDR 上报
XDR_WEBHOOK_URL=
XDR_WEBHOOK_SECRET=
XDR_TASK_TOKEN=
