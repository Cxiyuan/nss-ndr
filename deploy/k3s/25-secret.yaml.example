# NSS-NDR 部署凭据（k3s kubectl apply -k 路径）
#
# 用法（推荐）：bash releases/gen-secret.sh
#   - elastic-password 固定默认值 nss-ndr@2026（Kibana/ES 登录账号）
#   - filebeat / kibana_system / xdr-push / redis 密码随机生成（内部服务账号）
#   - Kibana 加密 key 随机生成（xpack.security / encryptedSavedObjects / reporting）
# 也可手工复制本文件为 25-secret.yaml 并修改（25-secret.yaml 不入库）。
#
# 注意：部署前必须存在 25-secret.yaml（kustomization 引用），否则 kubectl apply -k 会失败。
apiVersion: v1
kind: Secret
metadata:
  name: nss-ndr-secrets
  namespace: nss-ndr
type: Opaque
stringData:
  elastic-password: "nss-ndr@2026"
  filebeat-password: CHANGE_ME_filebeat
  kibana-password: CHANGE_ME_kibana
  kibana-encryption-key: CHANGE_ME_kibana_encryption
  kibana-encrypted-saved-objects-key: CHANGE_ME_kibana_eso
  kibana-reporting-key: CHANGE_ME_kibana_reporting
  xdr-push-password: CHANGE_ME_xdr
  redis-password: CHANGE_ME_redis
