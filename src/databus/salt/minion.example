# ============================================================================
# masterless salt-minion 配置示例（推荐方案）
# ----------------------------------------------------------------------------
# 目标机 172.16.199.235：
#   1) 安装 salt-minion（不装 salt-master）
#   2) /etc/salt/minion 写入本文件内容（或放到 /etc/salt/minion.d/databus.conf）
#   3) 状态文件 -> /srv/salt/，pillar -> /srv/pillar/
#   4) 首跑：salt-call --local state.apply databus.deploy
#   5) 自愈：schedule 每 1 小时 state.apply databus
# ============================================================================

file_client: local

file_roots:
  base:
    - /srv/salt

pillar_roots:
  base:
    - /srv/pillar

id: nss-ndr-databus-host

# 周期自愈：每 60 分钟应用一次数据总线状态
schedule:
  databus-highstate:
    function: state.apply
    args:
      - databus
    hours: 1
    maxrunning: 1

log_level: info
log_level_logfile: info
