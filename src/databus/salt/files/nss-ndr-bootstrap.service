[Unit]
Description=NSS-NDR Bootstrap (salt masterless deploy)
Documentation=https://github.com/Cxiyuan/nss-ndr
After=docker.service network-online.target
Wants=docker.service network-online.target
ConditionPathExists=/root/deploy.sh
ConditionPathExists=/srv/salt/databus/top.sls

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/root/deploy.sh
TimeoutStartSec=1800
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
