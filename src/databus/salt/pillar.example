# ============================================================================
# 数据总线 Salt pillar 示例
# ----------------------------------------------------------------------------
# 自 2026-08-31 起，本项目采用 master + minion 容器化部署：
#   - nss-ndr-salt-master-api 容器（nss-ndr/salt-master-api 镜像）
#   - nss-ndr-salt-minion    容器（nss-ndr/salt-minion    镜像，host network）
# 盐命令模板（template state 文件）由以下命令铺到 /srv/salt/：
#   salt-cp <master> databus/files/*  /srv/salt/databus/
# 或初次部署时把仓库 src/databus/salt/{files,scripts,states/} 直接 scp。
# 动态 token（KIBANA_SERVICE_TOKEN 等）由 bootstrap 阶段生成写入
# /etc/nss-ndr/.env，不在 pillar 中维护。
# ============================================================================

databus:
  env_file: /etc/nss-ndr/.env
  base_dir: /opt/nss-ndr
  images_dir: /root/nss-ndr/images
  tz: Asia/Shanghai
  zeek_interface: ens192

  network:
    name: nss-net
    subnet: 192.168.250.0/24

  creds:
    elastic_username: elastic
    elastic_password: ChangeMe_Elastic_2026!
    redis_password: ChangeMe_Redis_2026!
    kibana_encryption_key: NSS-NDR-Default-Kibana-Encryption-Key-2026!

  images:
    - name: nss-ndr/zeek:8.2.2
      tar: nss-ndr_zeek_8.2.2.tar
    - name: docker.elastic.co/elasticsearch/elasticsearch:9.5.2
      tar: docker.elastic.co_elasticsearch_elasticsearch_9.5.2.tar
    - name: docker.elastic.co/kibana/kibana:9.5.2
      tar: docker.elastic.co_kibana_kibana_9.5.2.tar
    - name: nss-ndr/elastic-agent-zeek:9.5.2
      tar: nss-ndr_elastic-agent-zeek_9.5.2.tar
    - name: nss-ndr/logstash-databus:9.5.2
      tar: nss-ndr_logstash-databus_9.5.2.tar
    - name: nss-ndr/redis-databus:8.10.1
      tar: nss-ndr_redis-databus_8.10.1.tar
    - name: nss-ndr/llm-server:0.1.0
      tar: nss-ndr_llm-server_0.1.0.tar
    - name: nss-ndr/salt-master-api:0.1.0
      tar: nss-ndr_salt-master-api_0.1.0.tar
    - name: nss-ndr/salt-minion:0.1.0
      tar: nss-ndr_salt-minion_0.1.0.tar

  fixed_ips:
    elasticsearch: 192.168.250.40
    kibana: 192.168.250.50
    fleet_server: 192.168.250.55
    elastic_agent: 192.168.250.20
    logstash: 192.168.250.30
    redis: 192.168.250.60
    llm_server: 192.168.250.90
    salt_master_api: 192.168.250.5

  host_ports:
    es: 9200
    kibana: 5601
    fleet_server: 8220
    redis: 6379
    salt_api: 8000
  # 宿主机端口绑定地址（仅本机监听，外部不可达）
  host_bind: 127.0.0.1

  # AI 分析智能体（nss-ndr/agent）
  agent:
    image: nss-ndr/agent:0.1.1
    ip: 192.168.250.80
    # dry_run: 0 = 生产模式（写 verdict / entity / ES）；1 = 只读消费
    # 上游已部署 llm-server + LLM 模型，启用 LLM 本地边缘分析时置 0；
    # 仅做链路验证、不需要 LLM 真实调用时改回 1
    dry_run: "0"
    log_level: INFO
    llm:
      edge_base_url: "http://llm-server:8080/v1"
      edge_api_key: ""
      edge_model: "Qwen3-0.6B-Q8_0"
      cloud_base_url: ""
      cloud_api_key: ""
      cloud_model: ""

  # LLM Server（nss-ndr/llm-server）
  llm_server:
    image: nss-ndr/llm-server:0.1.0
    ip: 192.168.250.90
    port: 8080
    model_path: /models/Qwen3-0.6B-Q8_0.gguf
    model_alias: Qwen3-0.6B-Q8_0
    context_size: 32768
    parallel: 1
    batch_size: 2048
    ubatch_size: 512
    cache_type_k: q8_0
    cache_type_v: q8_0
    # 空 = llama-server 自动按物理核数；高密度共享机器可显式限制避免争抢
    threads: ""
    api_key: ""
    extra_args: ""

  # Salt Master + Salt API（容器化，自 2026-08-31 起替代宿主机 salt-minion RPM）
  salt_master_api:
    image: nss-ndr/salt-master-api:0.1.0
    ip: 192.168.250.5
    api_port: 8000
    api_user: saltapi
    # 默认空 = 容器 entrypoint 自动生成 24 位随机密码并写入 /etc/nss-ndr/.env
    # 也可在此显式固定（适合需要给外部 salt-api 客户端的稳定凭证）
    api_password: ""

  # Salt Minion（容器化，host network + bind /var/run/docker.sock）
  salt_minion:
    image: nss-ndr/salt-minion:0.1.0
    # minion id 与 master minion_key 绑定；改名后需重新 enroll
    id: nss-ai-agent-minion

  configs:
    - src: salt://databus/files/kibana.yml
      dst: /etc/nss-ndr/kibana.yml
      mode: "644"
    - src: salt://databus/files/elastic-agent-fleet-server.yml
      dst: /etc/nss-ndr/elastic-agent-fleet-server.yml
      mode: "644"
    - src: salt://databus/files/jvm.options
      dst: /etc/nss-ndr/jvm.options
      mode: "644"
