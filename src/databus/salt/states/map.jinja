# ============================================================================
# map.jinja：pillar 取值 + 动态 token 读取
# 动态 token 由 bootstrap 阶段写入 /etc/nss-ndr/.env，渲染时读取。
# ============================================================================

{%- set databus = salt['pillar.get']('databus', {}) %}

{# LLM Server 命名空间（独立于 databus，方便覆盖默认值） #}
{%- set llm_server = {
    'image':       salt['pillar.get']('databus:llm_server:image',       'nss-ndr/llm-server:latest'),
    'ip':          salt['pillar.get']('databus:llm_server:ip',          '192.168.250.90'),
    'port':        salt['pillar.get']('databus:llm_server:port',        8080),
    'model_path':  salt['pillar.get']('databus:llm_server:model_path',  '/models/Qwen3-0.6B-Q8_0.gguf'),
    'model_alias': salt['pillar.get']('databus:llm_server:model_alias', 'Qwen3-0.6B-Q8_0'),
    'context_size': salt['pillar.get']('databus:llm_server:context_size', 32768),
    'parallel':    salt['pillar.get']('databus:llm_server:parallel',    1),
    'batch_size':  salt['pillar.get']('databus:llm_server:batch_size',  2048),
    'ubatch_size': salt['pillar.get']('databus:llm_server:ubatch_size', 512),
    'cache_type_k': salt['pillar.get']('databus:llm_server:cache_type_k', 'q8_0'),
    'cache_type_v': salt['pillar.get']('databus:llm_server:cache_type_v', 'q8_0'),
    'threads':     salt['pillar.get']('databus:llm_server:threads',     ''),
    'api_key':     salt['pillar.get']('databus:llm_server:api_key',     ''),
    'extra_args':  salt['pillar.get']('databus:llm_server:extra_args',  ''),
} -%}

{# Salt Master + Salt API 命名空间 #}
{%- set salt_master_api = {
    'image':        salt['pillar.get']('databus:salt_master_api:image',       'nss-ndr/salt-master-api:0.1.1'),
    'ip':           salt['pillar.get']('databus:salt_master_api:ip',          '192.168.250.5'),
    'api_port':     salt['pillar.get']('databus:salt_master_api:api_port',    8000),
    'api_user':     salt['pillar.get']('databus:salt_master_api:api_user',    'saltapi'),
    'api_password': salt['pillar.get']('databus:salt_master_api:api_password',''),
} -%}

{# Salt Minion 命名空间（与本机 master-api 配对）#}
{%- set salt_minion = {
    'image': salt['pillar.get']('databus:salt_minion:image', 'nss-ndr/salt-minion:0.1.2'),
    'id':    salt['pillar.get']('databus:salt_minion:id',    'nss-ai-agent-minion'),
    'ip':    salt['pillar.get']('databus:salt_minion:ip',    '192.168.250.2'),
} -%}

{# 注意：jinja2 宏体不能访问模板顶层 {% set %} 变量，
   因此 env_get 在宏体内自行读取文件（宏内可直接调用 salt 模块）。 #}
{%- macro env_get(key) -%}
{%-   set _env_file = salt['pillar.get']('databus:env_file', '/etc/nss-ndr/.env') -%}
{%-   if salt['file.file_exists'](_env_file) -%}
{%-     set _content = salt['file.read'](_env_file) -%}
{%-     for _line in (_content or '').split('\n') -%}
{%-       if _line.startswith(key ~ '=') -%}
{{ _line.split('=', 1)[1] }}
{%-       endif -%}
{%-     endfor -%}
{%-   endif -%}
{%- endmacro -%}

{# 命名空间固定前缀（与 compose 保持一致） #}
{%- set ns = 'nss-ndr' -%}
