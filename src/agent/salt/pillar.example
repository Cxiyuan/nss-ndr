# ============================================================================
# 智能体 Salt pillar 示例
# ----------------------------------------------------------------------------
# masterless minion: 复制到 /srv/pillar/agent.sls
# 动态密钥（ES/REDIS/LLM）从 /etc/nss-ndr/.env 读取，不在 pillar 维护。
# ============================================================================

agent:
  tz: Asia/Shanghai
  images_dir: /root/nss-agent

  images:
    - name: nss-ndr/agent:0.1.1
      tar: nss-ndr_agent_0.1.1.tar

  fixed_ip: 192.168.250.80
  network: nss-net
  container_name: nss-ndr-agent

  config_dir: /etc/nss-ndr/agent

  configs:
    - src: salt://agent/files/agent.yaml
      dst: /etc/nss-ndr/agent/agent.yaml
      mode: "644"
    - src: salt://agent/files/providers.yaml
      dst: /etc/nss-ndr/agent/providers.yaml
      mode: "644"
    - src: salt://agent/files/rules/beh-rules.yaml
      dst: /etc/nss-ndr/agent/rules/beh-rules.yaml
      mode: "644"
