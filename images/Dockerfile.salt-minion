# ============================================================================
# 深瞳安全分析智能体 · Salt Minion 容器镜像
# ----------------------------------------------------------------------------
# 镜像名：nss-ndr/salt-minion:<版本>
# 用途：
#   - 与本机 salt-master-api 容器配对
#   - 通过 host network 与 master-api ZeroMQ（4505/4506）通信
#   - 通过 bind mount /var/run/docker.sock 调用 docker state 模块
# 设计要点：
#   - 基于 Alpine 3.21 + Python 3.12 + Salt 3007.14（同 master 镜像版本）
#   - 必须 host network（salt ZeroMQ 通信）
#   - 必须 bind /var/run/docker.sock（Salt docker 状态调用）
#   - 必须 bind /srv/salt、/srv/pillar（state 文件共享给 master）
#   - 非 root 用户 salt（uid 10002）
#   - 启动入口 /usr/local/bin/salt-minion-entrypoint：
#       1. 渲染 /etc/salt-minion/minion 配置（master host + id）
#       2. 前台启动 salt-minion
# ============================================================================

FROM alpine:3.21 AS builder

ARG SALT_VERSION=3007.14

RUN apk add --no-cache \
        python3 \
        python3-dev \
        py3-pip \
        py3-cryptography \
        py3-pycryptodome \
        py3-setuptools \
        build-base \
        linux-headers \
        openssl-dev \
        libffi-dev \
        zeromq-dev

RUN pip3 install --no-cache-dir --break-system-packages \
        "salt==${SALT_VERSION}"

# 运行时镜像
FROM alpine:3.21

ARG SALT_VERSION=3007.14

RUN apk add --no-cache \
        python3 \
        py3-cryptography \
        py3-pycryptodome \
        py3-pip \
        py3-yaml \
        py3-jinja2 \
        py3-msgpack \
        py3-requests \
        py3-pygit2 \
        py3-packaging \
        py3-looseversion \
        zeromq \
        libffi \
        openssl \
        tini \
        curl

LABEL org.opencontainers.image.title="nss-ndr/salt-minion" \
      org.opencontainers.image.description="深瞳安全分析智能体 Salt Minion 容器（host network + Docker state 模块，Salt 3007.14）" \
      org.opencontainers.image.version="0.1.0" \
      org.opencontainers.image.source="https://github.com/Cxiyuan/nss-ndr"

COPY --from=builder /usr/lib/python3*/site-packages/ /usr/lib/python3*/site-packages/ 2>/dev/null || true
COPY --from=builder /usr/bin/salt-minion /usr/bin/salt-minion
COPY --from=builder /usr/bin/salt-call /usr/bin/salt-call

ENV SALT_MINION_HOME=/home/salt \
    SALT_CONFIG_DIR=/etc/salt-minion

RUN adduser -D -u 10002 -H -s /sbin/nologin salt \
    && mkdir -p \
        ${SALT_CONFIG_DIR} \
        /var/run/salt \
        /var/cache/salt \
        /var/log/salt \
    && chown -R salt:salt \
        /var/run/salt \
        /var/cache/salt \
        /var/log/salt

# 内置 minion 配置模板
COPY salt-minion/minion.tmpl ${SALT_CONFIG_DIR}/minion.tmpl
COPY salt-minion/entrypoint.sh /usr/local/bin/salt-minion-entrypoint
RUN chmod +x /usr/local/bin/salt-minion-entrypoint

# 注意：Salt Minion ZeroMQ 通信必须 host network；启动时由 docker run --network=host 指定
EXPOSE 4505 4506

ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/salt-minion-entrypoint"]
CMD []