# ============================================================================
# 深瞳安全分析智能体 · Salt Minion 容器镜像
# ----------------------------------------------------------------------------
# 镜像名：nss-ndr/salt-minion:<版本>
# 用途：
#   - 与本机 salt-master-api 容器配对
#   - 通过 nss-net 与 master-api ZeroMQ（4505/4506）通信
#   - 通过 bind mount /var/run/docker.sock 调用 docker state 模块（docker-py）
# 设计要点：
#   - 基于 python:3.10-alpine（salt 3007.x 官方仅支持 Python 3.10）
#   - pip install salt + docker-py（salt docker state 模块需要）
#   - 必须 bind /var/run/docker.sock（Salt docker 状态调用）
#   - 必须 bind /srv/salt、/srv/pillar（state 文件共享给 master）
# ============================================================================

FROM python:3.10-alpine

ARG SALT_VERSION=3007.14

RUN sed -i 's#dl-cdn.alpinelinux.org#mirrors.aliyun.com/alpine#g; s#alpine/alpine/v3#alpine/v3#g' /etc/apk/repositories \
    && apk update \
    && apk add --no-cache \
        zeromq \
        libffi \
        openssl \
        openssl-dev \
        openblas \
        openssh-client \
        shadow \
        tini \
        curl \
        bash \
        busybox-extras \
        tzdata \
    && rm -rf /var/cache/apk/* \
    && ln -sf /usr/lib/libcrypto.so.3 /usr/lib/libcrypto.so \
    && ln -sf /usr/lib/libssl.so.3 /usr/lib/libssl.so

LABEL org.opencontainers.image.title="nss-ndr/salt-minion" \
      org.opencontainers.image.description="深瞳安全分析智能体 Salt Minion 容器（Python 3.10 + Salt 3007.14 + docker-py）" \
      org.opencontainers.image.version="0.1.0" \
      org.opencontainers.image.source="https://github.com/Cxiyuan/nss-ndr"

ENV SALT_MINION_HOME=/home/salt \
    SALT_CONFIG_DIR=/etc/salt-minion \
    PIP_INDEX_URL="${PIP_INDEX_URL:-https://pypi.tuna.tsinghua.edu.cn/simple}"

# 非特权用户（Alpine BusyBox 无 standalone adduser，用 python 脚本创建）
COPY salt-adduser.py /tmp/salt-adduser.py
RUN python3 /tmp/salt-adduser.py \
    && mkdir -p /etc/salt-minion /var/run/salt /var/cache/salt /var/log/salt \
                /srv/salt /srv/pillar \
    && chmod -R 0755 /home/salt \
    && chown -R 10002:10002 /var/run/salt /var/cache/salt /var/log/salt \
                          /srv/salt /srv/pillar

# 安装 salt + docker-py（salt docker state 模块通过 docker-py 直连 docker daemon，
# 不需要 docker CLI；Alpine musl 也无法运行 glibc 的 docker 二进制）
RUN pip3 install --no-cache-dir --break-system-packages -i "${PIP_INDEX_URL}" \
        "salt==${SALT_VERSION}" \
        pyzmq \
        pycryptodome \
        cryptography \
        markupsafe \
        distro \
        docker \
        tornado \
        PyYAML \
        jinja2 \
        msgpack \
        requests \
        packaging \
        looseversion \
        psutil \
        distro

# smoke 校验
RUN for f in salt-minion salt-call; do \
        command -v "$f" >/dev/null 2>&1 && echo "[smoke] $f OK: $($f --version 2>&1 | head -1)" || echo "[smoke] $f MISSING"; \
    done

# 修补 salt/utils/rsax931.py（Alpine musl 下 find_library 找不到 libcrypto）
COPY salt-master-api/patch-rsax931.py /opt/patch-rsax931.py
RUN python3 /opt/patch-rsax931.py

# 内置 minion 配置模板
# 烘焙部署辅助脚本(gen-kibana-token/fleet-setup/vault-render-env/agent-setup)——不再 salt 下发
COPY salt-minion/scripts/ /opt/nss-ndr/scripts/
RUN chmod +x /opt/nss-ndr/scripts/*.sh

COPY salt-minion/minion.tmpl ${SALT_CONFIG_DIR}/minion.tmpl
COPY salt-minion/entrypoint.sh /usr/local/bin/salt-minion-entrypoint
RUN chmod +x /usr/local/bin/salt-minion-entrypoint \
    && chown -R salt:salt /etc/salt-minion

# 注意：Salt Minion ZeroMQ 通信由 docker run 指定网络（nss-net）
EXPOSE 4505 4506

ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/salt-minion-entrypoint"]
CMD []