# ============================================================================
# 深瞳安全分析智能体 · Salt Minion 容器镜像
# ----------------------------------------------------------------------------
# 镜像名：nss-ndr/salt-minion:<版本>
# 用途：
#   - 与本机 salt-master-api 容器配对
#   - 通过 host network 与 master-api ZeroMQ（4505/4506）通信
#   - 通过 bind mount /var/run/docker.sock 调用 docker state 模块
# 设计要点：
#   - 基于官方 Salt 镜像 saltstack/salt:3007.14-py3
#   - 必须 host network（salt ZeroMQ 通信）
#   - 必须 bind /var/run/docker.sock（Salt docker 状态调用）
#   - 必须 bind /srv/salt、/srv/pillar（state 文件共享给 master）
#   - 启动入口 /usr/local/bin/salt-minion-entrypoint：
#       1. 渲染 /etc/salt-minion/minion 配置（master host + id）
#       2. 前台启动 salt-minion
# ============================================================================

FROM saltstack/salt:3007.14-py3

ARG SALT_VERSION=3007.14

LABEL org.opencontainers.image.title="nss-ndr/salt-minion" \
      org.opencontainers.image.description="深瞳安全分析智能体 Salt Minion 容器（基于 saltstack/salt:3007.14-py3 + host network + Docker state）" \
      org.opencontainers.image.version="0.1.0" \
      org.opencontainers.image.source="https://github.com/Cxiyuan/nss-ndr"

RUN (id salt 2>/dev/null || adduser -D -u 10002 -H -s /sbin/nologin salt) \
    && mkdir -p \
        /etc/salt-minion \
        /var/run/salt \
        /var/cache/salt \
        /var/log/salt \
        /srv/salt /srv/pillar \
    && chown -R salt:salt \
        /var/run/salt \
        /var/cache/salt \
        /var/log/salt \
        /srv/salt /srv/pillar \
    || true

# 内置 minion 配置模板
COPY salt-minion/minion.tmpl /etc/salt-minion/minion.tmpl
COPY salt-minion/entrypoint.sh /usr/local/bin/salt-minion-entrypoint
RUN chmod +x /usr/local/bin/salt-minion-entrypoint

# 注意：Salt Minion ZeroMQ 通信必须 host network；启动时由 docker run --network=host 指定
EXPOSE 4505 4506

ENTRYPOINT ["/usr/local/bin/salt-minion-entrypoint"]
CMD []