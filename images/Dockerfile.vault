# ============================================================================
# 数据总线 · Vault 镜像（Vault 凭据管理：应用密码唯一来源）
# ----------------------------------------------------------------------------
# 设计：
#   - 基于官方 hashicorp/vault（无需自编译）
#   - vault.hcl bake 到 /vault/config/vault.hcl（官方 entrypoint 自动加载）
#   - vault-bootstrap.sh 覆盖 entrypoint：init/unseal/kv-seed 幂等
#     （不 bind 宿主机任何路径；unseal key / root token 存命名卷 nss-vault-secrets）
#   - 仅 nss-net 内网 8200
# ============================================================================
ARG VAULT_VERSION=latest
FROM hashicorp/vault:${VAULT_VERSION}

# vault.hcl 放官方默认 config 目录（docker-entrypoint 自动 `vault server -config`）
COPY vault/vault.hcl /vault/config/vault.hcl

# bootstrap 脚本（覆盖 CMD，容器启动后由 entrypoint 执行）
COPY --chmod=755 vault/vault-bootstrap.sh /usr/local/bin/vault-bootstrap

# 预建 /vault/secrets（命名卷挂载点，bootstrap 写 unseal key/root token/RO token）
# 注意：官方 entrypoint 只 chown /vault/config /vault/file /vault/logs，不含 /vault/secrets；
#      命名卷首挂会继承镜像该目录属主，故这里显式 chown 给 vault 用户
RUN mkdir -p /vault/secrets && chown vault:vault /vault/secrets

LABEL org.opencontainers.image.title="nss-ndr/vault" \
      org.opencontainers.image.description="数据总线 Vault 容器（凭据管理 + kv seed，无宿主挂载）" \
      org.opencontainers.image.version="latest" \
      org.opencontainers.image.source="https://github.com/Cxiyuan/nss-ndr"

# 官方镜像 ENTRYPOINT 是 docker-entrypoint.sh（chown + setcap 后 exec CMD）
# 我们覆盖 CMD 为 vault-bootstrap（脚本内自行启动 vault server 后台 + init/unseal/seed）
CMD ["vault-bootstrap"]
