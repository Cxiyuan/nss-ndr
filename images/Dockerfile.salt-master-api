# ============================================================================
# 深瞳安全分析智能体 · Salt Master + Salt API 容器镜像
# ----------------------------------------------------------------------------
# 镜像名：nss-ndr/salt-master-api:<版本>
# 用途：
#   - salt-master：ZeroMQ 4505/4506 端口，接收本机 salt-minion 连接
#   - salt-api：CherryPy + HTTP 8000 端口，对外暴露 REST/eauth API
#   - 与同机 salt-minion 容器配合，完成 master+minion 集中管理
# 设计要点：
#   - 基于官方 Salt 镜像 saltstack/salt:3007.14-py3（Alpine + Python 3.12 +
#     Salt 3007.14，salt-master / salt-api / salt-key / salt-run / salt-call 等
#     入口点已正确生成）
#   - 内置 salt 配置（master / api 模板）于 /etc/salt-master-api/
#   - 启动入口 /usr/local/bin/salt-master-api-entrypoint：
#       1. 渲染 /etc/salt-master-api/master / api 配置
#       2. 启动 salt-master（后台）
#       3. 等 4505 端口 ready
#       4. 启动 salt-api（前台）
#   - 容器固定 IP nss-net 上 192.168.250.5（与本机 masterless 时代
#     /etc/salt/minion.d/local.conf 不冲突）
# ============================================================================

FROM saltstack/salt:3007.14-py3

ARG SALT_VERSION=3007.14

# 镜像元数据
LABEL org.opencontainers.image.title="nss-ndr/salt-master-api" \
      org.opencontainers.image.description="深瞳安全分析智能体 Salt Master + Salt API 容器（基于 saltstack/salt:3007.14-py3）" \
      org.opencontainers.image.version="0.1.0" \
      org.opencontainers.image.source="https://github.com/Cxiyuan/nss-ndr"

# 镜像运行时 UID 已是 root；不必再加 adduser。
# 但我们建议用非 root uid 10002 跑 salt-master。
RUN (id salt 2>/dev/null || adduser -D -u 10002 -H -s /sbin/nologin salt) \
    && mkdir -p \
        /etc/salt-master-api \
        /var/run/salt \
        /var/cache/salt \
        /var/log/salt \
        /srv/salt /srv/pillar \
    && chown -R salt:salt \
        /var/run/salt \
        /var/cache/salt \
        /var/log/salt \
        /srv/salt /srv/pillar \
    || true

# 内置配置模板（容器启动时由 entrypoint 渲染到 /etc/salt-master-api/）
COPY salt-master-api/master.tmpl /etc/salt-master-api/master.tmpl
COPY salt-master-api/api.tmpl /etc/salt-master-api/api.tmpl
COPY salt-master-api/eauth.tmpl /etc/salt-master-api/eauth.tmpl
COPY salt-master-api/entrypoint.sh /usr/local/bin/salt-master-api-entrypoint
RUN chmod +x /usr/local/bin/salt-master-api-entrypoint

EXPOSE 4505 4506 8000

# 官方镜像默认 entrypoint 已是 tini 包装的 python；直接覆盖为我们的 entrypoint
ENTRYPOINT ["/usr/local/bin/salt-master-api-entrypoint"]
CMD []