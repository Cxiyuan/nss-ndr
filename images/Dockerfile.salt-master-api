# ============================================================================
# 深瞳安全分析智能体 · Salt Master + Salt API 容器镜像
# ----------------------------------------------------------------------------
# 镜像名：nss-ndr/salt-master-api:<版本>
# 用途：
#   - salt-master：ZeroMQ 4505/4506 端口，接收本机 salt-minion 连接
#   - salt-api：CherryPy + HTTP 8000 端口，对外暴露 REST/eauth API
#   - 与同机 salt-minion 容器配合，完成 master+minion 集中管理
# 设计要点：
#   - 基于 python:3.10-alpine（官方声明 salt 3007.x 仅支持 Python 3.10；
#     Python 3.12 下 distutils 被移除导致 console_scripts 不注册、
#     state 引擎模块加载死锁等兼容问题，故必须用 3.10）
#   - pip install salt 在 3.10 下正常生成 salt-master/salt-api/salt-key 入口点
#   - 内置 salt 配置（master / api 模板）于 /etc/salt-master-api/
#   - 启动入口 /usr/local/bin/salt-master-api-entrypoint：
#       1. 装 pyzmq / cherrypy / tornado（Alpine musl 官方 wheel）
#       2. 用 Python 创建 saltapi 用户（Alpine 无 adduser）
#       3. 后台启动 salt-master，等 4505 ready
#       4. 前台启动 salt-api
# ============================================================================

FROM python:3.10-alpine

ARG SALT_VERSION=3007.14

# 运行时依赖（Alpine musl + salt 系统库 + busybox-nc 用于端口探活）
RUN apk add --no-cache \
        zeromq \
        libffi \
        openssl \
        openblas \
        openssh-client \
        shadow \
        tini \
        curl \
        busybox-extras \
        tzdata \
    && rm -rf /var/cache/apk/*

# 镜像元数据
LABEL org.opencontainers.image.title="nss-ndr/salt-master-api" \
      org.opencontainers.image.description="深瞳安全分析智能体 Salt Master + Salt API 容器（Python 3.10 + Salt 3007.14）" \
      org.opencontainers.image.version="0.1.0" \
      org.opencontainers.image.source="https://github.com/Cxiyuan/nss-ndr"

ENV SALT_MASTER_API_HOME=/home/salt \
    SALT_CONFIG_DIR=/etc/salt-master-api \
    SALT_RUN_DIR=/var/run/salt \
    SALT_CACHE_DIR=/var/cache/salt \
    SALT_LOG_DIR=/var/log/salt \
    PIP_INDEX_URL="${PIP_INDEX_URL:-https://pypi.tuna.tsinghua.edu.cn/simple}"

# 非特权用户（Alpine BusyBox 无 standalone adduser，用 python 脚本创建）
COPY salt-adduser.py /tmp/salt-adduser.py
RUN python3 /tmp/salt-adduser.py \
    && mkdir -p /etc/salt-master-api /var/run/salt /var/cache/salt /var/log/salt \
                /srv/salt /srv/pillar \
    && chmod -R 0755 /home/salt \
    && chown -R 10002:10002 /var/run/salt /var/cache/salt /var/log/salt \
                          /srv/salt /srv/pillar

# 安装 salt 3007.14（Python 3.10 下 distutils 正常，console_scripts 自动注册）
# 附依赖：pyzmq（ZeroMQ）、pycryptodome、markupsafe、distro、tornado、cherrypy（salt-api）
# PyYAML / jinja2 / msgpack / requests 等 salt 核心依赖（python:3.10-alpine 不自带）
RUN pip3 install --no-cache-dir --break-system-packages -i "${PIP_INDEX_URL}" \
        "salt==${SALT_VERSION}" \
        pyzmq \
        pycryptodome \
        markupsafe \
        distro \
        tornado \
        cherrypy \
        PyYAML \
        jinja2 \
        msgpack \
        requests \
        packaging \
        looseversion \
        psutil \
        distro

# smoke 校验：入口点应已被 pip 自动注册到 /usr/local/bin/
RUN for f in salt-master salt-api salt-key salt-run salt-call; do \
        command -v "$f" >/dev/null 2>&1 && echo "[smoke] $f OK: $($f --version 2>&1 | head -1)" || echo "[smoke] $f MISSING"; \
    done

# 修补 salt/utils/event.py（非 dict return 时的事件丢失 bug，见 patch-event.py 注释）
COPY salt-master-api/patch-event.py /opt/patch-event.py
RUN python3 /opt/patch-event.py

# 创建 saltapi 系统用户（salt-api PAM external_auth 需要；Alpine 无 adduser）
COPY salt-master-api/create-saltapi.py /opt/create-saltapi.py
RUN python3 /opt/create-saltapi.py

# 内置配置模板（容器启动时由 entrypoint 渲染到 /etc/salt-master-api/）
COPY salt-master-api/master.tmpl ${SALT_CONFIG_DIR}/master.tmpl
COPY salt-master-api/api.tmpl ${SALT_CONFIG_DIR}/api.tmpl
COPY salt-master-api/eauth.tmpl ${SALT_CONFIG_DIR}/eauth.tmpl
COPY salt-master-api/entrypoint.sh /usr/local/bin/salt-master-api-entrypoint
RUN chmod +x /usr/local/bin/salt-master-api-entrypoint \
    && chown -R salt:salt /etc/salt-master-api

EXPOSE 4505 4506 8000

# tini 兜底 PID 1 信号转发
ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/salt-master-api-entrypoint"]
CMD []