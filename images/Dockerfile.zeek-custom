# ============================================================================
# 数据总线 · Zeek 自定义镜像（方案 C：配置由 salt 下发宿主机 bind，不 bake）
# ----------------------------------------------------------------------------
# 配置 local.zeek/detect.zeek 不再 bake——由 salt configs.sls 下发到
# /opt/nss/ndr/zeek/，容器 bind 只读挂载到 site/local.zeek + site/scripts/
# 本镜像仅保留运行环境（官方 zeek 基座）
# ============================================================================
ARG BASE_IMAGE=zeek/zeek:8.2.2
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.title="nss-ndr/zeek-databus" \
      org.opencontainers.image.description="Zeek 8.2.2 (config bind-mounted, databus)" \
      org.opencontainers.image.version="8.2.2"
