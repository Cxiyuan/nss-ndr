# 数据总线 · Kibana（官方镜像原样继承，随 CI 一并推送到 GHCR）
# 配置全部外挂（Salt 通过环境变量/挂载下发），镜像层无改动
FROM docker.elastic.co/kibana/kibana:9.5.2

# 烘焙 kibana.yml(不包含加密 key,key 由 env 注入)——不再宿主挂载
COPY salt/files/kibana.yml /usr/share/kibana/config/kibana.yml

LABEL org.opencontainers.image.title="nss-ndr/kibana" \
      org.opencontainers.image.description="Kibana 9.5.2 (official, databus)" \
      org.opencontainers.image.version="9.5.2"
