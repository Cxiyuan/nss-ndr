# 数据总线 · Kibana（官方镜像原样继承，随 CI 一并推送到 GHCR）
# 方案 C：kibana.yml 由 salt configs.sls 下发到 /opt/nss/ndr/kibana/，
# 容器 bind 只读挂载到 /usr/share/kibana/config/kibana.yml（镜像不 bake）
FROM docker.elastic.co/kibana/kibana:9.5.2

LABEL org.opencontainers.image.title="nss-ndr/kibana" \
      org.opencontainers.image.description="Kibana 9.5.2 (official, config bind-mounted)" \
      org.opencontainers.image.version="9.5.2"
