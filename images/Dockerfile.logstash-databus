# ============================================================================
# 数据总线 · Logstash 自定义镜像（方案 C：配置由 salt 下发宿主机 bind，不 bake）
# ----------------------------------------------------------------------------
# pipeline/zeek-pipeline.conf + config/*.yml 不再 bake——
# 由 salt configs.sls 下发到 /opt/nss/ndr/logstash/，容器 bind 只读挂载
# 本镜像仅保留官方 Logstash 基座
# ============================================================================
FROM docker.elastic.co/logstash/logstash:9.5.2

LABEL org.opencontainers.image.title="nss-ndr/logstash-databus" \
      org.opencontainers.image.description="Logstash 9.5.2 (pipeline bind-mounted, databus)" \
      org.opencontainers.image.version="9.5.2"
