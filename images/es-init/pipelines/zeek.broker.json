{
  "description": "NSS-NDR zeek.broker（集群内部事件）",
  "processors": [
    { "set": { "field": "event.dataset", "value": "broker" } },
    { "json": { "field": "message", "target_field": "message2", "ignore_failure": true } },
    { "rename": { "field": "message2.event_name", "target_field": "event.action", "ignore_missing": true } },
    { "rename": { "field": "message2.peer", "target_field": "server.address", "ignore_missing": true } },
    { "pipeline": { "name": "zeek.common" } }
  ],
  "version": 1
}
