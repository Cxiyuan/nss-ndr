{
  "description": "NSS-NDR zeek.http",
  "processors": [
    { "set": { "field": "event.dataset", "value": "http" } },
    { "json": { "field": "message", "target_field": "message2", "ignore_failure": true } },
    { "rename": { "field": "message2.uri", "target_field": "url.full", "ignore_missing": true } },
    { "rename": { "field": "message2.host", "target_field": "url.domain", "ignore_missing": true } },
    { "rename": { "field": "message2.method", "target_field": "http.request.method", "ignore_missing": true } },
    { "rename": { "field": "message2.user_agent", "target_field": "user_agent.original", "ignore_missing": true } },
    { "rename": { "field": "message2.status_code", "target_field": "http.response.status_code", "ignore_missing": true } },
    { "pipeline": { "name": "zeek.common" } }
  ]
}
