{
  "description": "NSS-NDR zeek.software（软件指纹）",
  "processors": [
    { "set": { "field": "event.dataset", "value": "software" } },
    { "json": { "field": "message", "target_field": "message2", "ignore_failure": true } },
    { "rename": { "field": "message2.software_type", "target_field": "software.type", "ignore_missing": true } },
    { "rename": { "field": "message2.name", "target_field": "software.name", "ignore_missing": true } },
    { "rename": { "field": "message2.version", "target_field": "software.version", "ignore_missing": true } },
    { "rename": { "field": "message2.unparsed_version", "target_field": "software.unparsed_version", "ignore_missing": true } },
    { "pipeline": { "name": "zeek.common" } }
  ],
  "version": 1
}
