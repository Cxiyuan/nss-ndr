{
  "description": "NSS-NDR zeek.dns",
  "processors": [
    { "set": { "field": "event.dataset", "value": "dns" } },
    { "json": { "field": "message", "target_field": "message2", "ignore_failure": true } },
    { "rename": { "field": "message2.query", "target_field": "dns.question.name", "ignore_missing": true } },
    { "rename": { "field": "message2.qtype_name", "target_field": "dns.question.type", "ignore_missing": true } },
    { "rename": { "field": "message2.rcode_name", "target_field": "dns.response_code", "ignore_missing": true } },
    { "rename": { "field": "message2.answers", "target_field": "dns.answers", "ignore_missing": true } },
    { "pipeline": { "name": "zeek.common" } }
  ]
}
