{
  "description": "NSS-NDR suricata.alert 检测线索（signal），供 XDR 下发分析任务进一步研判",
  "processors": [
    { "set": { "field": "event.kind", "value": "alert" } },
    { "set": { "field": "event.category", "value": ["network"] } },
    { "set": { "field": "event.type", "value": ["intrusion_detection"] } },
    { "set": { "field": "nss.detection.stage", "value": "clue" } },
    { "append": { "field": "tags", "value": ["alert", "clue"] } },
    { "rename": { "field": "alert", "target_field": "rule", "ignore_missing": true } },
    { "rename": { "field": "rule.signature", "target_field": "rule.name", "ignore_missing": true } },
    { "rename": { "field": "rule.signature_id", "target_field": "rule.uuid", "ignore_missing": true } },
    { "rename": { "field": "rule.severity", "target_field": "event.severity", "ignore_missing": true } },
    { "rename": { "field": "payload_printable", "target_field": "network.data.decoded", "ignore_missing": true } },
    { "pipeline": { "name": "suricata.common" } }
  ]
}
