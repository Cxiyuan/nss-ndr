{
  "description": "NSS-NDR zeek.x509",
  "processors": [
    { "set": { "field": "event.dataset", "value": "x509" } },
    { "json": { "field": "message", "target_field": "message2", "ignore_failure": true } },
    { "rename": { "field": "message2.subject", "target_field": "x509.subject", "ignore_missing": true } },
    { "rename": { "field": "message2.issuer", "target_field": "x509.issuer", "ignore_missing": true } },
    { "pipeline": { "name": "zeek.common" } }
  ]
}
