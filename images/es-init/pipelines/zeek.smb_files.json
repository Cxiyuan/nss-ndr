{
  "description": "NSS-NDR zeek.smb_files（Zeek 8 SMB 文件访问日志）",
  "processors": [
    {
      "set": {
        "field": "event.dataset",
        "value": "smb_files"
      }
    },
    {
      "json": {
        "field": "message",
        "target_field": "message2",
        "ignore_failure": true
      }
    },
    {
      "rename": {
        "field": "message2.action",
        "target_field": "smb.action",
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "field": "message2.path",
        "target_field": "smb.path",
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "field": "message2.name",
        "target_field": "smb.name",
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "field": "message2.size",
        "target_field": "smb.size",
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "field": "message2.prev_name",
        "target_field": "smb.prev_name",
        "ignore_missing": true
      }
    },
    {
      "pipeline": {
        "name": "zeek.common"
      }
    }
  ]
}
